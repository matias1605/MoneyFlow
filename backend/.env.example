# Copiá este archivo como ".env" y completá tu contraseña real de PostgreSQL.
# El archivo ".env" está en .gitignore y NUNCA se sube al repositorio.

# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/moneyflow?schema=public"

# Puerto del backend (opcional, por defecto 3001)
PORT=3001
